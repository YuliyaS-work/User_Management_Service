pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: python
    image: python:3.13
    imagePullPolicy: IfNotPresent
    command: ['sh', '-c', 'sleep 3600']
    workingDir: /home/jenkins/agent
    securityContext:
      runAsUser: 0
    tty: true
  - name: docker
    image: docker:dind
    imagePullPolicy: IfNotPresent
    securityContext:
      privileged: true
    volumeMounts:
    - name: dind-storage
      mountPath: /var/lib/docker
  - name: kubectl
    image: bitnami/kubectl:latest
    imagePullPolicy: IfNotPresent
    command: ['sh', '-c', 'sleep 3600']
    workingDir: /home/jenkins/agent
    securityContext:
      runAsUser: 0
    tty: true
  volumes:
  - name: dind-storage
    emptyDir: {}
'''
        }
    }

    stages {

        stage('Python CI (Install, Lint, Tests)') {
            steps {
                container('python') {
                    dir('user_management_api'){
                        sh '''
                            pip install --no-cache-dir poetry
                            poetry install --no-root
                            poetry run ruff format --check .
                            poetry run ruff check .
                        '''
                        withEnv([
                            'DATABASE_URL=sqlite+aiosqlite:///./test.db',
                            'SECRET_KEY=test',
                            'ALGORITHM=HS256',
                            'REDIS_HOST=localhost',
                            'REDIS_PORT=6379',
                            'REDIS_PASSWORD=test',
                            'AWS_ACCESS_KEY_ID=test',
                            'AWS_SECRET_ACCESS_KEY=test',
                            'AWS_REGION=us-east-1',
                            'BUCKET_NAME=test',
                            'RABBITMQ_URL=amqp://guest:guest@localhost/'
                        ]) {
                            sh '''
                                poetry run coverage run -m pytest
                                poetry run coverage report
                            '''
                        }
                    }
                }
            }
        }

        stage('Build & Push Docker') {
            steps {
                container('docker') {
                    dir('user_management_api'){
                        withCredentials([usernamePassword(credentialsId: 'docker-hub-creds', passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
                            sh '''
                                docker info >/dev/null 2>&1 || (dockerd-entrypoint.sh & sleep 5)
                                echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                                docker build -t yuliyaswork/ums:latest .
                                docker push yuliyaswork/ums:latest
                            '''
                        }
                    }
                }
            }
        }

        stage('Deploy to Minikube') {
            steps {
                container('kubectl') {
                    dir('infra-repo') {
                        git branch: 'feature/k8s', credentialsId: 'github-token', url: 'https://github.com/YuliyaS-work/Innotter_Infrastructure.git'

                        sh '''
                            kubectl apply -f k8s/namespace.yaml
                            kubectl apply -f k8s/ums/ums-deployment.yaml --validate=false
                            kubectl apply -f k8s/ums/ums-service.yaml --validate=false
                            kubectl rollout restart deployment ums -n app
                            kubectl rollout status deployment ums -n app --timeout=60s
                        '''
                    }
                }
            }
        }
    }
}