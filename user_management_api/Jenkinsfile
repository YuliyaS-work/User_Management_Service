pipeline {
    agent {
        docker {
            image 'python:3.13'
            args '-u root'
        }
    }
    stages('Python CI (Install, Lint, Tests)') {

        stage('Install Poetry') {
            steps {
                dir('user_management_api'){
                    sh 'pip install poetry'
                    sh 'poetry install'
                }
            }
        }

        stage('Lint/Format') {
            steps {
                dir('user_management_api'){
                    sh 'poetry run black .'
                    sh 'poetry run flake8 .'
                }
            }
        }

        stage('Tests') {
            steps {
                dir('user_management_api'){
                    sh 'poetry run pytest --cov=.'
                }
            }
        }

        stage('Build Docker') {
            steps {
                dir('user_management_api'){
                    sh 'docker build -t ums-1/ums:latest .'
                }
            }
        }

        stage('Push Docker') {
            steps {
                dir('user_management_api'){
                    withCredentials([usernamePassword(credentialsId: 'docker-hub-creds', passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
                        sh 'docker login -u $DOCKER_USER -p $DOCKER_PASS'
                        sh 'docker push ums-1/ums:latest'
                    }
                }
            }
        }

        stage('Deploy to minikube') {
            steps {
                dir('user_management_api'){
                    sh 'kubectl apply -f ../infrastructure/k8s/ums-deployment.yaml'
                    sh 'kubectl rollout restart deployment ums -n app'
                }
            }
        }
    }
}